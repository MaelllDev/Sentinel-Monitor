# ──────────────────────────────────────────────────────────────
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA faça commit do .env com dados reais.
# ──────────────────────────────────────────────────────────────

# ── MASTER ──────────────────────────────────────────────────
# Token do bot (obtido via @BotFather no Telegram)
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Seu chat_id do Telegram (obtenha via @userinfobot)
ALLOWED_CHAT_ID=987654321

# Chave de autenticação entre master e nodes (gere uma aleatória!)
# Exemplo: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=troque-por-uma-chave-aleatoria-segura

# IP ou domínio público do master (usado no /integrar)
MASTER_HOST=192.168.1.100

# Porta do servidor WebSocket do master
WS_PORT=8765

# ── NODE ────────────────────────────────────────────────────
# URL do WebSocket do master (usado ao rodar o node na VPS)
MASTER_WS_URL=ws://192.168.1.100:8765

# Nome amigável desta VPS
NODE_NAME=minha-vps

# Intervalo de envio de métricas em segundos
METRICS_INTERVAL=10

# ── ALERTAS (thresholds em %) ────────────────────────────────
ALERT_CPU=90
ALERT_MEMORY=90
ALERT_DISK=90

# ── CASAOS (opcional) ────────────────────────────────────────
# URL base do CasaOS (geralmente http://<ip-do-servidor>:80)
# Deixe em branco para desativar os comandos /casa*
CASAOS_URL=http://192.168.1.100:80
# Usuário e senha do CasaOS (usados para login automático)
# O bot renova o token automaticamente — não é necessário copiar tokens manualmente.
CASAOS_USER=admin
CASAOS_PASSWORD=sua-senha-aqui
