[Unit]
Description=Sentinel Monitor (master + node local)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%INSTALL_DIR%

# Sobe master e node local
ExecStart=/usr/bin/docker compose up -d master node-local

# Para os containers ao parar o serviço
ExecStop=/usr/bin/docker compose stop master node-local

# Se o docker compose não estiver no path padrão, tenta o legado
ExecStartPre=-/bin/sh -c "docker compose version >/dev/null 2>&1 || ln -sf /usr/local/bin/docker-compose /usr/bin/docker-compose"

Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
